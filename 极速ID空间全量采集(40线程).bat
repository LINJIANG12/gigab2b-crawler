@echo off
chcp 65001 >nul
title GigaB2B 商品 ID 空间极速全量采集 (40 线程)
cd /d "%~dp0"

echo ========================================================
echo        GigaB2B 商品 ID 空间 40 线程极速全量采集
echo ========================================================
echo.
echo [说明] 该脚本通过商品 ID 全局空间直扫，突破所有搜索截断限制。
echo [说明] 采用 40 线程极速并发 + 异步批量写入，预计速率 30~50 ID/秒。
